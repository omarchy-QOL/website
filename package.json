{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "omarchy-qol-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev --open --host 127.0.0.1 --port 3000",
    "build": "astro build --config astro.cloudflare.config.mjs",
    "preview": "astro preview --config astro.cloudflare.config.mjs",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seo:check": "node scripts/check-seo.mjs",
    "test:redirects": "node --test tests/redirect-worker.test.mjs",
    "verify": "npm run format:check && npm run check && npm run build && npm run seo:check && npm run test:redirects"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.6",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.0",
    "@fontsource/ibm-plex-mono": "5.2.5",
    "astro": "7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@bruits/satteri-wasm32-wasi": "0.10.5",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "wrangler": "4.128.0",
    "yaml": "2.9.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": [
          "*.md",
          "*.qmd"
        ],
        "options": {
          "printWidth": 80,
          "proseWrap": "always"
        }
      }
    ]
  }
}
