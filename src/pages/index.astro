---
import { getCollection } from "astro:content"
import SiteHeader from "../components/SiteHeader.astro"
import VideoGrid from "../components/VideoGrid.astro"
import BaseLayout from "../layouts/BaseLayout.astro"

export const prerender = true

const docs = await getCollection("docs")
const overview = docs.find((entry) => entry.id === "docs")

const plugins = docs
  .filter((entry) => entry.data.pluginOrder !== undefined)
  .sort((left, right) => (left.data.pluginOrder ?? 0) - (right.data.pluginOrder ?? 0))

const publishedPlugins = plugins.filter((plugin) => plugin.data.status === "published")
const metaplug = plugins.find((plugin) => plugin.id.endsWith("/metaplug"))
const syncshell = plugins.find((plugin) => plugin.id.endsWith("/syncshell"))
const syncshellVideos = syncshell?.data.videos ?? []
---

<BaseLayout description={overview?.data.description}>
  <div class="site-shell landing-shell">
    <SiteHeader />
    <main class="landing-main">
      <div class="home-page">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-content">
            <h1 class="landing-heading" id="hero-title">
              {overview?.data.description}
            </h1>
          </div>
        </section>

        {
          syncshellVideos.length > 0 && (
            <section class="section-block landing-demo-section" aria-labelledby="syncshell-demo-title">
              <div class="section-heading landing-demo-heading">
                <h2 id="syncshell-demo-title">Demo of Syncshell</h2>
                <a class="text-link" href={syncshell ? `/${syncshell.id}` : "/docs/plugins/syncshell"}>
                  View Syncshell
                </a>
              </div>
              <VideoGrid videos={syncshellVideos} preload="none" />
            </section>
          )
        }

        <section class="section-block" id="plugins" aria-labelledby="plugins-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">The plugins</p>
              <h2 id="plugins-title">{publishedPlugins.length} plugins from the Omarchy-QoL setup</h2>
            </div>
          </div>

          <div class="plugin-grid">
            {
              publishedPlugins.map((plugin) => (
                <a class="plugin-card" href={`/${plugin.id}`}>
                  <h3>{plugin.data.title}</h3>
                  <p>{plugin.data.shortDescription}</p>
                  <span class="plugin-card-category">{plugin.data.category}</span>
                </a>
              ))
            }
          </div>
        </section>

        <section class="labs-callout" aria-labelledby="labs-title">
          <div>
            <p class="eyebrow">Labs</p>
            <h2 id="labs-title">Ideas and experiments for future plugins</h2>
          </div>
          <p>
            Metaplug and Dropbox Quota are current experiments. So neither has a public install yet, but you can get
            them from GitHub directly.
          </p>
          <a class="text-link" href={metaplug ? `/${metaplug.id}` : "/docs/plugins/metaplug"}>Poke around</a>
        </section>
      </div>
    </main>
  </div>
</BaseLayout>
