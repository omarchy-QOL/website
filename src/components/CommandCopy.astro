---
import { Icon } from "@astrojs/starlight/components"
---

<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" aria-hidden="true" style="position: absolute">
  <defs>
    <symbol id="command-copy-document" viewBox="0 0 16 16">
      <Icon name="document" size="16px" />
    </symbol>
  </defs>
</svg>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>(".command-copy")

  for (const button of copyButtons) {
    button.addEventListener("click", async () => {
      const command = button.dataset.command
      const label = button.querySelector("span")
      if (!command || !label) return

      try {
        await navigator.clipboard.writeText(command)
        button.dataset.state = "copied"
        button.setAttribute("aria-label", "Command copied")
        label.textContent = "Copied"
        window.setTimeout(() => {
          delete button.dataset.state
          button.setAttribute("aria-label", "Copy command")
          label.textContent = "Copy"
        }, 2500)
      } catch {
        button.dataset.state = "error"
        button.setAttribute("aria-label", "Copy failed, try again")
        label.textContent = "Try again"
      }
    })
  }
</script>
