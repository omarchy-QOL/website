---
import { Icon } from "@astrojs/starlight/components"
import VideoGrid from "./VideoGrid.astro"

interface Screenshot {
  src: string
  alt: string
  caption: string
  width: number
  height: number
}

interface Video {
  src: string
  poster: string
  title: string
  description: string
  duration: string
  uploadDate: string
  width: number
  height: number
}

interface Props {
  status: "published" | "lab"
  version: string
  kinds: string[]
  highlights: string[]
  sourceUrl?: string
  installCommand?: string
  screenshots?: Screenshot[]
  videos?: Video[]
}

const { status, version, kinds, highlights, sourceUrl, installCommand, screenshots = [], videos = [] } = Astro.props

const hasDemo = screenshots.length > 0 || videos.length > 0
---

<div class="docs-kicker">
  <span class:list={["status-badge", `status-${status}`]}>{status === "lab" ? "Lab" : "Published"}</span>
  <span>v{version}</span>
</div>

<div class="kind-list" aria-label="Plugin kinds">
  {kinds.map((kind) => <span>{kind}</span>)}
</div>

{
  hasDemo && (
    <section class="docs-section demo-section" aria-labelledby="demo-title">
      <p class="docs-label">Demo</p>
      <h2 id="demo-title">See it before you install it</h2>

      {screenshots.length > 0 && (
        <div class="demo-screenshot-grid">
          {screenshots.map((screenshot) => (
            <figure class="demo-figure">
              <a class="demo-image-frame" href={screenshot.src} target="_blank" rel="noreferrer">
                <img
                  src={screenshot.src}
                  alt={screenshot.alt}
                  width={screenshot.width}
                  height={screenshot.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>{screenshot.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}

      {videos.length > 0 && (
        <div class="demo-video-section">
          <h3>Videos</h3>
          <VideoGrid videos={videos} />
        </div>
      )}
    </section>
  )
}

<section class="docs-section" aria-labelledby="does-title">
  <p class="docs-label">Overview</p>
  <h2 id="does-title">What it does</h2>
  <ul class="feature-list">
    {highlights.map((highlight) => <li>{highlight}</li>)}
  </ul>
</section>

{
  installCommand ? (
    <section class="docs-section" aria-labelledby="install-title">
      <p class="docs-label">Quick start</p>
      <h2 id="install-title">Install from GitHub</h2>
      <pre class="command-block">
        <code>{installCommand}</code>
      </pre>
      <p class="docs-note">
        Review the repository README before installation for current dependencies, configuration notes, and removal
        behavior.
      </p>
    </section>
  ) : (
    <section class="docs-section lab-notice" aria-labelledby="lab-title">
      <p class="docs-label">Status</p>
      <h2 id="lab-title">Still in the workshop</h2>
      <p>
        This experiment is tracked locally and is not offered as a public install yet. Its page records the direction
        without pretending the interface or data contract is finished.
      </p>
    </section>
  )
}

{
  sourceUrl && (
    <section class="source-panel" aria-label="Source repository">
      <div>
        <p class="docs-label">Source code</p>
        <h2>README, code, issues, and releases</h2>
      </div>
      <a class="button button-primary source-button" href={sourceUrl}>
        <Icon name="github" size="1.1rem" />
        <span>GitHub</span>
      </a>
    </section>
  )
}
