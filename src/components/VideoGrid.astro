---
interface Video {
  src: string
  poster: string
  title: string
  description: string
  duration: string
  uploadDate: string
  width: number
  height: number
}

interface Props {
  videos: Video[]
  preload?: "none" | "metadata"
}

const { videos, preload = "metadata" } = Astro.props
---

<div class="demo-video-grid">
  {
    videos.map((video) => (
      <figure class="demo-figure">
        <video
          controls
          muted
          playsinline
          poster={video.poster}
          preload={preload}
          width={video.width}
          height={video.height}
        >
          <source src={video.src} type="video/mp4" />
          <a href={video.src}>Open the {video.title} video</a>
        </video>
        <figcaption>
          <span class="demo-caption-title">{video.title}</span>
          <span class="demo-caption-description">{video.description}</span>
        </figcaption>
      </figure>
    ))
  }
</div>
