---
import DefaultMarkdownContent from "@astrojs/starlight/components/MarkdownContent.astro"
import PluginDetails from "./PluginDetails.astro"

interface PluginData {
  pluginOrder?: number
  status?: "published" | "lab"
  version?: string
  kinds?: string[]
  highlights?: string[]
  sourceUrl?: string
  installCommand?: string
  screenshots?: Array<{ src: string; alt: string; caption: string; width: number; height: number }>
  videos?: Array<{
    src: string
    poster: string
    title: string
    description: string
    duration: string
    uploadDate: string
    width: number
    height: number
  }>
}

const data = Astro.locals.starlightRoute.entry.data as PluginData
const isPlugin = data.pluginOrder !== undefined
---

<DefaultMarkdownContent>
  {
    isPlugin ? (
      <PluginDetails
        status={data.status!}
        version={data.version!}
        kinds={data.kinds!}
        highlights={data.highlights!}
        sourceUrl={data.sourceUrl}
        installCommand={data.installCommand}
        screenshots={data.screenshots}
        videos={data.videos}
      />
    ) : (
      <slot />
    )
  }
</DefaultMarkdownContent>
