---
import DefaultMarkdownContent from "@astrojs/starlight/components/MarkdownContent.astro"
import PluginDetails from "../PluginDetails.astro"
import CommandCopy from "../CommandCopy.astro"

const data = Astro.locals.starlightRoute.entry.data
---

<DefaultMarkdownContent>
  {
    data.pluginOrder !== undefined ? (
      <PluginDetails {...data}>
        <slot />
      </PluginDetails>
    ) : (
      <slot />
    )
  }
</DefaultMarkdownContent>
<CommandCopy />
