---
import { Icon } from "@astrojs/starlight/components"
import Brand from "./Brand.astro"
---

<header class="site-header">
  <div class="brand-cluster">
    <Brand />
    <span class="brand-subtitle">Quality-of-life plugin development</span>
  </div>
  <nav class="header-meta" aria-label="Primary navigation">
    <a href="/docs">
      <Icon name="open-book" size="0.95rem" />
      <span>Docs</span>
    </a>
    <a href="https://github.com/omarchy-QOL">
      <Icon name="github" size="0.95rem" />
      <span>GitHub</span>
    </a>
  </nav>
</header>
