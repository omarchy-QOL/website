---
import { Icon } from "@astrojs/starlight/components"
import Brand from "./Brand.astro"

interface Props {
  layer: "landing" | "docs"
}

const { layer } = Astro.props
---

<header class="site-header">
  <div class="brand-cluster">
    <Brand />
    {layer === "landing" && <span class="brand-subtitle">Quality-of-life plugin development</span>}
  </div>
  <nav class="header-meta" aria-label="Primary navigation">
    {
      layer === "landing" ? (
        <>
          <a href="/docs">
            <Icon name="open-book" size="0.95rem" />
            <span>Docs</span>
          </a>
          <a href="https://github.com/omarchy-QOL">
            <Icon name="github" size="0.95rem" />
            <span>GitHub</span>
          </a>
        </>
      ) : (
        <>
          <a href="/">
            <Icon name="left-arrow" size="0.95rem" />
            <span>Home</span>
          </a>
          <a href="https://github.com/omarchy-QOL">
            <Icon name="github" size="0.95rem" />
            <span>GitHub</span>
          </a>
        </>
      )
    }
  </nav>
</header>
